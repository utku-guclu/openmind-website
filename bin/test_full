#!/usr/bin/env bash
# Full-stack test runner — boots Postgres, prepares the test DB, tails the
# Rails test log to your terminal with a [server] prefix, and runs the
# Minitest suite. System tests open a real (visible) Chromium so you can
# watch the browser drive the app.
#
# Usage:
#   bin/test_full              # boot stack + tail logs + run all tests headed
#   bin/test_full unit         # only model + controller tests (fast, no browser)
#   bin/test_full system       # only system tests (headed browser)
#   HEADLESS=1 bin/test_full   # hide the browser (CI-style)
#
# Env:
#   HEADLESS=1                 forwards to Capybara → headless Chrome
#   KEEP_DB=1                  skip docker compose down at the end (handy
#                              when iterating; default leaves Postgres up
#                              anyway since the script never stops it)

set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"

# Make sure rbenv shims are visible (this script may run from environments
# that haven't sourced your shell rc).
export PATH="$HOME/.rbenv/shims:$PATH"

red()    { printf '\033[31m%s\033[0m\n' "$*"; }
green()  { printf '\033[32m%s\033[0m\n' "$*"; }
yellow() { printf '\033[33m%s\033[0m\n' "$*"; }
bold()   { printf '\033[1m%s\033[0m\n' "$*"; }

mode="${1:-all}"
test_paths=()
case "$mode" in
  unit)   test_paths=(test/models test/controllers) ;;
  system) test_paths=(test/system) ;;
  all|"") test_paths=(test/models test/controllers test/system) ;;
  *)      red "unknown mode: $mode (expected: unit | system | all)"; exit 2 ;;
esac

bold "── prereqs ──"
command -v docker >/dev/null || { red "docker not found"; exit 2; }
command -v ruby   >/dev/null || { red "ruby not found";   exit 2; }
docker info >/dev/null 2>&1  || { red "docker daemon is not running"; exit 2; }

bold "── postgres (TimescaleDB) ──"
if ! docker ps --format '{{.Names}}' | grep -q '^newomp_db$'; then
  docker compose up -d
fi
# Wait for healthy
for i in {1..30}; do
  if docker inspect newomp_db --format='{{.State.Health.Status}}' 2>/dev/null | grep -q healthy; then
    green "  postgres is healthy"; break
  fi
  sleep 1
  if (( i == 30 )); then red "postgres did not become healthy in 30s"; exit 1; fi
done

bold "── test DB ──"
bin/rails db:test:prepare 2>&1 | tail -3

bold "── tail log/test.log → console ──"
: > log/test.log    # truncate so we only see this run's output
( tail -f log/test.log 2>/dev/null | sed -e 's/^/[server] /' ) &
TAIL_PID=$!
trap 'kill "$TAIL_PID" 2>/dev/null || true' EXIT INT TERM
green "  streaming server logs (PID $TAIL_PID) — Ctrl-C stops everything"

bold "── running tests (${test_paths[*]}) ──"
echo

# Pass through HEADLESS so application_system_test_case.rb picks the right
# Chrome driver. Default = headed.
set +e
bin/rails test "${test_paths[@]}"
exit_code=$?
set -e

echo
if (( exit_code == 0 )); then
  green "── PASS ──"
else
  red   "── FAIL (exit $exit_code) ──"
fi

# Give tail a moment to flush any final lines before EXIT trap kills it.
sleep 0.3
exit "$exit_code"
