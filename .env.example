# Copy this file to `.env` and fill in real values for your machine.
# `.env` is gitignored — never commit it.
#
#   cp .env.example .env
#
# Defaults that match docker-compose.yml are marked → so you can leave them
# blank and the app will still boot.

# ── Database ────────────────────────────────────────────────────────────────
# Postgres lives in the docker container `newomp_db` on host port 5433.
# Override only if you point the app at a different Postgres.
DB_PASSWORD=devpassword                # → docker-compose default

# ── Seed admin (`bin/rails db:seed`) ────────────────────────────────────────
# The first AdminUser created on a fresh database. Change these for any
# environment that isn't your laptop.
SEED_ADMIN_EMAIL=admin@openmindprojects.org
SEED_ADMIN_PASSWORD=changeme123

# ── Rails ───────────────────────────────────────────────────────────────────
# Most settings live in config/credentials.yml.enc (encrypted, in git) and
# are unlocked by config/master.key (NOT in git). Override here only when
# you need to.
# RAILS_LOG_LEVEL=debug
# RAILS_MAX_THREADS=5
# WEB_CONCURRENCY=2

# ── Active Storage backend ──────────────────────────────────────────────────
# Leave unset (or "local") to store uploads on local disk (db/seed_assets style).
# Set to "amazon" to route uploads to Cloudflare R2 using the R2_* vars below.
# STORAGE_SERVICE=amazon

# ── Cloudflare R2 (S3-compatible storage) ───────────────────────────────────
# Create a bucket at https://dash.cloudflare.com → R2 → Create bucket.
# Then create an API token (R2 → Manage R2 API Tokens → Create Token,
# permission: Object Read & Write, scoped to the bucket).
# Endpoint format: https://<account_id>.r2.cloudflarestorage.com
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
# R2_BUCKET=omp-media

# ── Optional integrations (uncomment + fill in as you add them) ─────────────
# OPENAI_API_KEY=sk-...
# SENDGRID_API_KEY=SG....
