<%# Reusable testimonial card partial
     Locals:
       testimonial: (Testimonial) ActiveRecord model instance
%>
<div class="about__card" id="testimonial-<%= testimonial.id %>" style="margin-bottom: var(--space-lg);">
  <% if testimonial.video_url.present? %>
    <div style="margin-bottom: var(--space-md); border-radius: var(--radius-md); overflow: hidden; aspect-ratio: 16/9;">
      <iframe
        src="<%= testimonial.video_url.gsub("watch?v=", "embed/") %>"
        style="width: 100%; height: 100%; border: 0;"
        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
        allowfullscreen
        loading="lazy"
        title="Testimonial from <%= testimonial.name %>"
      ></iframe>
    </div>
  <% end %>
  <% if testimonial.quote.present? %>
    <blockquote style="font-style: italic; color: var(--color-text-secondary); line-height: 1.8; margin-bottom: var(--space-md); border-left: 3px solid var(--color-primary); padding-left: var(--space-md);">
      "<%= testimonial.quote %>"
    </blockquote>
  <% end %>
  <div style="display: flex; align-items: center; gap: var(--space-sm);">
    <div style="width: 40px; height: 40px; border-radius: 50%; background: var(--gradient-primary); display: flex; align-items: center; justify-content: center; color: #fff; font-weight: 600; font-size: .85rem;">
      <%= testimonial.name[0].upcase %>
    </div>
    <div>
      <strong style="color: var(--color-text-primary);"><%= testimonial.name %></strong>
      <% if testimonial.role.present? || testimonial.country.present? %>
        <p style="font-size: .8rem; color: var(--color-text-secondary); margin: 0;">
          <%= [testimonial.role, testimonial.country].compact.join(" · ") %>
        </p>
      <% end %>
    </div>
  </div>
</div>
