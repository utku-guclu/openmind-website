<!-- ========== HERO ========== -->
<header class="hero" id="hero">
  <div class="hero__bg">
    <div class="hero__video-bg">
      <iframe
        src="https://www.youtube.com/embed/Sjdc-G7Ah7A?autoplay=1&mute=1&loop=1&playlist=Sjdc-G7Ah7A&controls=0&showinfo=0&rel=0&modestbranding=1&playsinline=1&enablejsapi=1"
        title="OpenMind Projects Background"
        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
        frameborder="0"
        allowfullscreen
      ></iframe>
    </div>
    <div class="hero__overlay"></div>
  </div>
  <div class="hero__content">
    <div class="hero__badge">
      <i class="ph ph-sparkle"></i>
      <span>Since <%= @settings["org_founded"] || "2001" %></span>
    </div>
    <h1 class="hero__title">
      <span class="hero__title-line"><%= @settings["hero_title"] || "Fight Poverty" %></span>
      <span class="hero__title-line hero__title-line--accent">with Education</span>
    </h1>
    <p class="hero__subtitle">
      <%= @settings["hero_subtitle"] || "Ethical and responsible volunteer work empowering impoverished youth and their parents in Southeast Asia." %>
    </p>
    <div class="hero__cta-group">
      <%= link_to new_application_path, class: "btn btn--primary btn--lg", id: "hero-volunteer" do %>
        <i class="ph ph-hand-heart"></i>
        <span>Volunteer Today</span>
      <% end %>
      <%= link_to projects_path, class: "btn btn--glass btn--lg", id: "hero-explore" do %>
        <i class="ph ph-compass"></i>
        <span>Explore Programs</span>
      <% end %>
    </div>
    <div class="hero__stats" data-controller="counter">
      <div class="hero__stat">
        <span class="hero__stat-value" data-counter-target="counter" data-count="<%= @settings["impact_years"] || 20 %>">0</span><span class="hero__stat-suffix">+</span>
        <span class="hero__stat-label">Years Active</span>
      </div>
      <div class="hero__stat-divider"></div>
      <div class="hero__stat">
        <span class="hero__stat-value" data-counter-target="counter" data-count="<%= @settings["impact_students"] || 5000 %>">0</span><span class="hero__stat-suffix">+</span>
        <span class="hero__stat-label">Students Trained</span>
      </div>
      <div class="hero__stat-divider"></div>
      <div class="hero__stat">
        <span class="hero__stat-value" data-counter-target="counter" data-count="<%= @settings["impact_countries"] || 3 %>">0</span>
        <span class="hero__stat-label">Countries</span>
      </div>
    </div>
  </div>
  <div class="hero__scroll-indicator" id="scroll-indicator">
    <span>Scroll</span>
    <div class="hero__scroll-line"></div>
  </div>
</header>

<!-- ========== HUB CTA + IMAGE CAROUSEL (two-column) ========== -->
<section class="hub-row" data-controller="reveal">
  <div class="container">
    <div class="hub-row__grid">
      <div class="hub-row__cta" data-reveal-target="item">
        <h2 class="hub-row__cta-title">Chonburi Hub is Calling</h2>
        <p class="hub-row__cta-desc">Get up to 100,000 THB in funding per project for skill development camps.</p>
        <%= link_to "https://sendimpact.com/?ff_landing=31", target: "_blank", rel: "noopener noreferrer nofollow", class: "btn btn--accent btn--lg" do %>
          Apply Now
        <% end %>
      </div>

      <div class="hub-row__carousel" data-reveal-target="item">
        <div class="carousel"
             data-controller="carousel"
             data-carousel-autoplay-value="5000"
             data-carousel-loop-value="true"
             data-carousel-per-view-value="1">
          <div class="carousel__viewport">
            <div class="carousel__track" data-carousel-target="track">
              <% [
                ["https://openmindprojects.org/wp-content/uploads/2026/04/2.jpg-1024x1024.jpeg", "Google Data center"],
                ["https://openmindprojects.org/wp-content/uploads/2026/04/13-1024x1024.jpg", "Skill development camp"],
                ["https://openmindprojects.org/wp-content/uploads/2026/04/1-1024x1024.jpg", "Active learning"],
                ["https://openmindprojects.org/wp-content/uploads/2026/04/11-1024x1024.jpg", "Community workshop"],
                ["https://openmindprojects.org/wp-content/uploads/2026/04/9-1024x1024.jpg", "Student training"],
                ["https://openmindprojects.org/wp-content/uploads/2026/04/8-1024x1024.jpg", "Volunteer with students"]
              ].each_with_index do |(src, alt), i| %>
                <figure class="carousel__slide" data-carousel-target="slide" aria-label="<%= i + 1 %> of 6">
                  <img src="<%= src %>" alt="<%= alt %>" loading="<%= i == 0 ? "eager" : "lazy" %>">
                </figure>
              <% end %>
            </div>
          </div>
          <button type="button" class="carousel__btn carousel__btn--prev" data-action="click->carousel#prev" aria-label="Previous slide">
            <i class="ph ph-caret-left"></i>
          </button>
          <button type="button" class="carousel__btn carousel__btn--next" data-action="click->carousel#next" aria-label="Next slide">
            <i class="ph ph-caret-right"></i>
          </button>
          <div class="carousel__pagination" data-carousel-target="pagination" role="tablist"></div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- ========== APPLY / GET INVOLVED ========== -->
<section class="apply" id="apply" data-controller="reveal">
  <div class="apply__bg"></div>
  <div class="container">
    <div class="apply__grid">
      <div class="apply__intro" data-reveal-target="item">
        <span class="section-header__tag"><i class="ph ph-paper-plane-tilt"></i> Get Involved</span>
        <h2 class="apply__title">Volunteer <span class="text-primary">Application</span></h2>
        <p class="apply__desc">
          Four simple steps from interest to impact. Watch how previous volunteers
          got started — then apply to join the next cohort.
        </p>
        <ol class="apply__steps">
          <li><span class="apply__step-num">1</span><span>Choose your program — onsite, online, or internship</span></li>
          <li><span class="apply__step-num">2</span><span>Tell us about your skills and interests</span></li>
          <li><span class="apply__step-num">3</span><span>We match you with the right project</span></li>
          <li><span class="apply__step-num">4</span><span>Start making an impact</span></li>
        </ol>
        <div class="apply__actions">
          <%= link_to new_application_path, class: "btn btn--accent btn--lg", id: "apply-cta" do %>
            <i class="ph ph-hand-heart"></i>
            <span>Volunteer Today</span>
          <% end %>
          <%= link_to destinations_path, class: "btn btn--ghost btn--lg" do %>
            <i class="ph ph-map-pin"></i>
            <span>See Locations</span>
          <% end %>
        </div>
      </div>
      <div class="apply__video-wrap" data-reveal-target="item">
        <div class="apply__video">
          <iframe
            src="https://www.youtube.com/embed/Sjdc-G7Ah7A"
            title="OpenMind Projects — Volunteer Story"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
            allowfullscreen
            loading="lazy"
          ></iframe>
        </div>
        <div class="apply__video-caption">
          <i class="ph ph-play-circle"></i>
          <span>Hear it from our volunteers</span>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- ========== PILLARS ========== -->
<section class="pillars" id="pillars" data-controller="reveal">
  <div class="container">
    <div class="section-header" data-reveal-target="item">
      <h2 class="section-header__title pillars__heading">What We Focus On</h2>
    </div>
    <div class="pillars__grid">
      <div class="pillar-card pillar-card--education" data-reveal-target="item" id="pillar-education">
        <%= link_to "/projects/computer-training", class: "pillar-card__tab" do %>
          Learn more <i class="ph-fill ph-arrow-circle-down"></i>
        <% end %>
        <figure class="pillar-card__image">
          <img src="https://openmindprojects.org/wp-content/uploads/2024/08/openmindprojects-training-center-scaled-e1724850364350.jpg"
               alt="OpenmindProjects volunteers and training center" loading="lazy">
        </figure>
        <h3 class="pillar-card__title">Educational &amp; Cross-cultural Training</h3>
        <div class="pillar-card__body">
          <p class="pillar-card__desc">Volunteers. Help and Train Youth and Adults</p>
          <p class="pillar-card__desc">Volunteer with OpenmindProjects. Help disadvantaged youth in Southeast Asia. Gain cross-cultural skills and contribute to our educational projects. Create a positive impact for others while you also learn and grow!</p>
        </div>
      </div>

      <div class="pillar-card pillar-card--development" data-reveal-target="item" id="pillar-development">
        <%= link_to "/projects/computer-training", class: "pillar-card__tab" do %>
          Learn more <i class="ph-fill ph-arrow-circle-down"></i>
        <% end %>
        <figure class="pillar-card__image">
          <img src="https://openmindprojects.org/wp-content/uploads/2024/08/volunteer-laos-ecotourism5.jpg"
               alt="Volunteer in Laos — ecotourism and local development" loading="lazy">
        </figure>
        <h3 class="pillar-card__title">Upskill &amp; Development for Local People</h3>
        <div class="pillar-card__body">
          <p class="pillar-card__desc">We address educational and employment gaps faced by disadvantaged youth in Southeast Asia. We provide English, technology and job skills training, and mentorships. We want to contribute to a more equitable society where underprivileged young people also can succeed.</p>
        </div>
      </div>

      <div class="pillar-card pillar-card--research" data-reveal-target="item" id="pillar-research">
        <%= link_to research_development_path, class: "pillar-card__tab" do %>
          Learn more <i class="ph-fill ph-arrow-circle-down"></i>
        <% end %>
        <figure class="pillar-card__image">
          <img src="https://openmindprojects.org/wp-content/uploads/2024/08/disable-learn-codeing-scaled.jpg"
               alt="Students learning coding — research and development" loading="lazy">
        </figure>
        <h3 class="pillar-card__title">Research &amp; Development</h3>
        <div class="pillar-card__body">
          <p class="pillar-card__desc">We are dedicated to empowering disadvantaged youth through technology, English and job skills development. We look for passionate people to help us and contribute expertise and support to our development work. We focus on creating innovative solutions to help local people through education and the access to it.</p>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- ========== GET INSPIRED ========== -->
<%
  source_videos = [
    { id: "64KzIobxLJI", title: "Francesco Palmieri Lupia — Teaching & Solar Energy", meta: "Volunteer · 4:38" },
    { id: "qiEXsT7PuWs", title: "IT Volunteer — Teach Coding",                         meta: "Workshop · 1:47" },
    { id: "3AfDLor6AM8", title: "A True Story — Alumni James",                         meta: "Alumni · 2:58" },
    { id: "63j5vQzyHew", title: "Day 2 of the Active Learning Camp",                   meta: "Camp · 1:12" },
    { id: "hZW4CRhD5wQ", title: "Couple Volunteer Abroad — Chris & Jacqueline",        meta: "Austria · 0:53" },
    { id: "D24B0i06c_M", title: "Laura Colantonio — Crafting Stories",                 meta: "Italy · 2:26" }
  ]
%>
<section class="inspired" id="inspired" data-controller="reveal">
  <div class="container">
    <div class="section-header" data-reveal-target="item">
      <span class="section-header__tag"><i class="ph ph-film-reel"></i> Stories</span>
      <h2 class="section-header__title">Get <span class="text-primary">Inspired</span></h2>
      <p class="section-header__desc">Hear directly from volunteers, alumni, and the communities we serve.</p>
    </div>
    <div class="inspired__grid">
      <% source_videos.each do |v| %>
        <article class="video-card" data-reveal-target="item" id="video-<%= v[:id] %>">
          <div class="video-card__media">
            <iframe
              src="https://www.youtube.com/embed/<%= v[:id] %>?rel=0"
              title="<%= v[:title] %>"
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
              allowfullscreen
              loading="lazy"
            ></iframe>
          </div>
          <div class="video-card__body">
            <h3 class="video-card__title"><%= v[:title] %></h3>
            <p class="video-card__meta"><%= v[:meta] %></p>
          </div>
        </article>
      <% end %>
    </div>
    <div class="inspired__actions" data-reveal-target="item">
      <%= link_to new_application_path, class: "btn btn--primary btn--lg" do %>
        <i class="ph ph-hand-heart"></i><span>Volunteer</span>
      <% end %>
      <%= link_to "https://idream.openmindprojects.org/", target: "_blank", rel: "noopener noreferrer nofollow", class: "btn btn--accent btn--lg" do %>
        <i class="ph ph-heart"></i><span>Give Today</span>
      <% end %>
    </div>
  </div>
</section>

<!-- ========== MISSION BAND ========== -->
<section class="mission-band" id="mission-band" data-controller="reveal">
  <div class="mission-band__inner" data-reveal-target="item">
    <p class="mission-band__text">
      Volunteer with <strong>OpenmindProjects</strong>, a nonprofit grassroots organization
      empowering impoverished youth and their parents in Southeast Asia.
    </p>
    <div class="mission-band__divider" aria-hidden="true"></div>
  </div>
</section>

<!-- ========== RECOGNIZED BY ========== -->
<section class="recognized" id="recognized" data-controller="reveal">
  <div class="container">
    <p class="recognized__label">Recognized &amp; Recommended by</p>
    <div class="recognized__rows" data-reveal-target="item">
      <div class="recognized__row">
        <img src="/partners/awards-row1.png" alt="GreatNonprofits Top Rated, GlobalGiving Vetted, UNESCO, CNN, Riot Games Social Impact Fund" loading="lazy">
      </div>
      <div class="recognized__row">
        <img src="/partners/awards-row2.png" alt="Rotary Club of San Jose, Bangkok Post, Lonely Planet, TechSoup, Digital Lift" loading="lazy">
      </div>
    </div>
  </div>
</section>

<!-- ========== CTA ========== -->
<section class="cta-section" id="get-involved" data-controller="reveal">
  <div class="cta-section__bg"></div>
  <div class="container">
    <div class="cta-section__content">
      <h2 class="cta-section__title" data-reveal-target="item">Ready to Make an Impact?</h2>
      <p class="cta-section__desc" data-reveal-target="item">
        Join a global community of volunteers, developers, and educators
        working to bridge the digital divide. Your skills can change lives.
      </p>
      <div class="cta-section__steps" data-reveal-target="item">
        <div class="cta-step">
          <div class="cta-step__number">1</div>
          <p>Choose your program — Volunteer, Intern, or Contribute online</p>
        </div>
        <div class="cta-step">
          <div class="cta-step__number">2</div>
          <p>Tell us about your skills and interests</p>
        </div>
        <div class="cta-step">
          <div class="cta-step__number">3</div>
          <p>We'll match you with the perfect project</p>
        </div>
        <div class="cta-step">
          <div class="cta-step__number">4</div>
          <p>Start creating impact!</p>
        </div>
      </div>
      <div class="cta-section__actions" data-reveal-target="item">
        <%= link_to new_application_path, class: "btn btn--accent btn--lg", id: "cta-apply" do %>
          <i class="ph ph-paper-plane-tilt"></i>
          <span>Apply Today</span>
        <% end %>
        <%= link_to donate_path, class: "btn btn--glass-dark btn--lg", id: "cta-donate" do %>
          <i class="ph ph-heart"></i>
          <span>Support with a Donation</span>
        <% end %>
      </div>
    </div>
  </div>
</section>
