<div data-controller="modal" class="modal-backdrop" data-action="click->modal#closeBackground keydown@window->modal#closeWithKeyboard">
  <div class="modal-dialog" role="dialog" aria-modal="true">
    <div class="modal-header">
      <% if local_assigns[:title] %>
        <h3 class="modal-title"><%= title %></h3>
      <% end %>
      <button class="modal-close" data-action="click->modal#close" aria-label="Close modal">
        <i class="ph ph-x"></i>
      </button>
    </div>
    <div class="modal-body">
      <%= yield %>
    </div>
  </div>
</div>
