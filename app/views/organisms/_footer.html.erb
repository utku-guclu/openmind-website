<footer class="footer" id="footer">
  <!-- Gold divider line -->
  <div class="footer__divider"></div>

  <div class="container">
    <!-- Logo centered -->
    <div class="footer__logo-wrap">
      <img src="/omp-logo.png" alt="OpenMind Projects" class="footer__logo-img" height="36">
    </div>

    <!-- Registration -->
    <p class="footer__registration">
      Registered Nonprofit: 2526/2 Thailand EST. 2001
    </p>

    <!-- Recognized by -->
    <p class="footer__recognized-title">Recognized and Recommended by:</p>

    <!-- Partner logos — two rows matching the live site -->
    <div class="footer__partners-carousel">
      <div class="footer__partners-row">
        <img src="/partners/awards-row1.png" alt="GreatNonprofits Top Rated, GlobalGiving Vetted, UNESCO, CNN, Riot Games Social Impact Fund" loading="lazy">
      </div>
      <div class="footer__partners-row">
        <img src="/partners/awards-row2.png" alt="Rotary Club of San Jose, Bangkok Post, Lonely Planet, TechSoup, Digital Lift" loading="lazy">
      </div>
    </div>

    <!-- Bottom links -->
    <div class="footer__bottom">
      <div class="footer__bottom-links">
        <%= link_to "About Us", about_path %>
        <%= link_to "Projects", projects_path %>
        <%= link_to "Volunteering", volunteer_path %>
        <%= link_to "R&D", research_development_path %>
        <%= link_to "Apply", new_application_path %>
        <%= link_to "Donate", donate_path %>
        <%= link_to "Contact", new_contact_path %>
      </div>
      <p class="footer__copy">&copy; <%= Date.current.year %> OpenMind Projects. All rights reserved.</p>
    </div>
  </div>
</footer>
