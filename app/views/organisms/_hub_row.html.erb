<%# Hub Row organism — CTA card (left) + image carousel (right). %>
<section class="hub-row" data-controller="reveal">
  <div class="container">
    <div class="hub-row__grid">
      <div class="hub-row__cta" data-reveal-target="item">
        <h2 class="hub-row__cta-title">Chonburi Hub is Calling</h2>
        <p class="hub-row__cta-desc">Get up to 100,000 THB in funding per project for skill development camps.</p>
        <%= link_to "https://sendimpact.com/?ff_landing=31", target: "_blank", rel: "noopener noreferrer nofollow", class: "btn btn--accent btn--lg" do %>
          Apply Now
        <% end %>
      </div>

      <div class="hub-row__carousel" data-reveal-target="item">
        <%= render "molecules/carousel",
                   slides: [
                     ["https://placehold.co/1024x1024/2a5d5a/ffffff?text=Google+Data+Center", "Google Data center"],
                     ["https://placehold.co/1024x1024/3d6b4a/ffffff?text=Skill+Camp",          "Skill development camp"],
                     ["https://placehold.co/1024x1024/5c7b4a/ffffff?text=Active+Learning",     "Active learning"],
                     ["https://placehold.co/1024x1024/8a5a4a/ffffff?text=Community+Workshop", "Community workshop"],
                     ["https://placehold.co/1024x1024/5a4a6b/ffffff?text=Student+Training",    "Student training"],
                     ["https://placehold.co/1024x1024/7b5c3a/ffffff?text=Volunteer+Students", "Volunteer with students"]
                   ],
                   autoplay: 5000,
                   per_view: 1 %>
      </div>
    </div>
  </div>
</section>
