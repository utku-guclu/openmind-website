<%# locals: { audience: } %>
<section class="audience-hero">
  <img src="<%= audience.hero_image_src %>" class="audience-hero__bg" alt="">
  <div class="audience-hero__overlay"></div>
  <div class="container audience-hero__content">
    <div class="audience-hero__badge">
      <i class="ph <%= audience.icon %>"></i>
      <span>For <%= audience.name %> Volunteers</span>
    </div>
    <h1 class="audience-hero__title"><%= audience.title %></h1>
    <p class="audience-hero__subtitle"><%= audience.subtitle %></p>
    <div class="audience-hero__meta">
      <span class="audience-hero__meta-item"><i class="ph ph-clock"></i> <%= audience.duration %></span>
    </div>
    <div class="audience-hero__actions">
      <%= link_to new_application_path, class: "btn btn--accent btn--lg", data: { turbo_frame: "modal" } do %>
        <i class="ph ph-paper-plane-tilt"></i> <%= audience.cta_text %>
      <% end %>
      <a href="#benefits" class="btn btn--glass btn--lg">
        <i class="ph ph-arrow-down"></i> Learn more
      </a>
    </div>
  </div>
</section>
