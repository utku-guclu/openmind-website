<%= form_with model: @application, url: applications_path, class: "form" do |f| %>
  <div style="position: absolute; left: -9999px;" aria-hidden="true">
    <%= f.label :website, "Leave this blank" %>
    <%= f.text_field :website, autocomplete: "off", tabindex: -1 %>
  </div>

  <% if @application.errors.any? %>
    <div style="padding: var(--space-md); background: rgba(231,76,60,.1); border: 1px solid #e74c3c; border-radius: var(--radius-md); margin-bottom: var(--space-lg); color: #e74c3c;">
      <% @application.errors.full_messages.each do |msg| %>
        <p><%= msg %></p>
      <% end %>
    </div>
  <% end %>

  <div class="form-row">
    <div class="form__group">
      <%= f.label :first_name, class: "form__label" %>
      <%= f.text_field :first_name, class: "form__input", required: true %>
    </div>
    <div class="form__group">
      <%= f.label :last_name, class: "form__label" %>
      <%= f.text_field :last_name, class: "form__input", required: true %>
    </div>
  </div>

  <div class="form-row">
    <div class="form__group">
      <%= f.label :email, class: "form__label" %>
      <%= f.email_field :email, class: "form__input", required: true %>
    </div>
    <div class="form__group">
      <%= f.label :phone, class: "form__label" %>
      <%= f.phone_field :phone, class: "form__input" %>
    </div>
  </div>

  <div class="form-row">
    <div class="form__group">
      <%= f.label :nationality, class: "form__label" %>
      <%= f.text_field :nationality, class: "form__input" %>
    </div>
    <div class="form__group">
      <%= f.label :date_of_birth, class: "form__label" %>
      <%= f.date_field :date_of_birth, class: "form__input" %>
    </div>
  </div>

  <div class="form__group">
    <%= f.label :application_type, "Program Type", class: "form__label" %>
    <%= f.select :application_type, [["Onsite Volunteering", "volunteer_onsite"], ["Online Volunteering", "volunteer_online"], ["Internship", "internship"]], { include_blank: "Select a program..." }, class: "form__input" %>
  </div>

  <div class="form-row">
    <div class="form__group">
      <%= f.label :project_id, "Preferred Project", class: "form__label" %>
      <%= f.collection_select :project_id, @projects, :id, :title, { include_blank: "Any project" }, class: "form__input" %>
    </div>
    <div class="form__group">
      <%= f.label :destination_id, "Preferred Destination", class: "form__label" %>
      <%= f.collection_select :destination_id, @destinations, :id, :name, { include_blank: "Any destination" }, class: "form__input" %>
    </div>
  </div>

  <div class="form-row">
    <div class="form__group">
      <%= f.label :preferred_start_date, class: "form__label" %>
      <%= f.date_field :preferred_start_date, class: "form__input" %>
    </div>
    <div class="form__group">
      <%= f.label :duration_weeks, "Duration (weeks)", class: "form__label" %>
      <%= f.number_field :duration_weeks, class: "form__input", min: 1, max: 52 %>
    </div>
  </div>

  <div class="form__group">
    <%= f.label :skills, class: "form__label" %>
    <%= f.text_area :skills, class: "form__input form__textarea", rows: 3, placeholder: "What skills can you bring?" %>
  </div>

  <div class="form__group">
    <%= f.label :motivation, class: "form__label" %>
    <%= f.text_area :motivation, class: "form__input form__textarea", rows: 4, placeholder: "Why do you want to volunteer with us?" %>
  </div>

  <div class="form__group">
    <%= f.label :experience, "Relevant Experience", class: "form__label" %>
    <%= f.text_area :experience, class: "form__input form__textarea", rows: 3, placeholder: "Any relevant experience..." %>
  </div>

  <%= f.submit "Submit Application", class: "btn btn--accent btn--lg btn--full" %>
<% end %>
