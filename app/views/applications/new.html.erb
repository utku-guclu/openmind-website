<%= turbo_frame_tag "modal" do %>
  <%= render "molecules/modal", title: "Volunteer Application" do %>
    <p class="section-header__desc" style="margin-bottom: var(--space-lg);">
      Fill out the form below and we'll get back to you within 48 hours.
    </p>

    <% if notice %>
      <div style="margin-bottom: var(--space-lg); padding: var(--space-md); background: rgba(76,175,80,.1); border: 1px solid var(--color-green); border-radius: var(--radius-md); text-align: center; color: var(--color-green);">
        <%= notice %>
      </div>
    <% end %>

    <%= render "form" %>
  <% end %>
<% end %>
