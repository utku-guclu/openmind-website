<% content_for(:title) { "Volunteer Application — OpenmindProjects" } %>
<% content_for(:description) { "Empower communities in Southeast Asia. Submit your volunteer application form securely today." } %>

<div class="volunteer-page-view" data-controller="volunteer-page">
  <div class="volunteer-modal__sheet" style="height: 100vh; height: 100dvh; max-height: 100vh; max-width: 100%; border-radius: 0; border: none;">
    <header class="volunteer-modal__header">
      <div class="volunteer-modal__brand">
        <a href="<%= root_path %>" class="volunteer-modal__logo-link">
          <img src="/omp-logo.png" alt="OpenmindProjects Logo" class="volunteer-modal__logo">
        </a>
        <div class="volunteer-modal__brand-meta">
          <span class="volunteer-modal__title">Volunteer Application</span>
          <span class="volunteer-modal__badge"><i class="ph ph-hand-heart"></i> Official Portal</span>
        </div>
      </div>
      
      <div class="volunteer-modal__status">
        <div class="volunteer-modal__status-pill">
          <span class="pulse-beacon pulse-beacon--success"></span>
          <span>SSL Secured Connection</span>
        </div>
      </div>

      <a class="volunteer-modal__close-btn" href="<%= root_path %>" aria-label="Back to home">
        <span class="volunteer-modal__close-text">Back to Home</span>
        <div class="volunteer-modal__close-icon-wrap">
          <i class="ph ph-arrow-left"></i>
        </div>
      </a>
    </header>

    <div class="volunteer-modal__body">
      <!-- High-end glassmorphic skeleton loader -->
      <div class="volunteer-modal__loader" data-volunteer-page-target="loader">
        <div class="volunteer-modal__loader-card">
          <div class="volunteer-modal__loader-logo-wrap">
            <img src="/omp-logo.png" alt="OMP Logo" class="volunteer-modal__loader-logo">
            <div class="volunteer-modal__loader-ring"></div>
          </div>
          <h3>Securing Connection...</h3>
          <p>Opening OpenmindProjects application portal on SendImpact</p>
          <div class="volunteer-modal__progress-bar">
            <div class="volunteer-modal__progress-fill"></div>
          </div>
          <div class="volunteer-modal__security-info">
            <i class="ph ph-lock-keyhole"></i>
            <span>End-to-End 256-Bit SSL Encryption</span>
          </div>
        </div>
      </div>

      <!-- Iframe for SendImpact -->
      <iframe 
        class="volunteer-modal__iframe" 
        data-volunteer-page-target="iframe"
        data-action="load->volunteer-page#onIframeLoad"
        src="https://sendimpact.com/?ff_landing=6"
        title="Volunteer Application Form"
        allow="geolocation; microphone; camera; midi; encrypted-media;"
        sandbox="allow-same-origin allow-scripts allow-forms allow-popups allow-popups-to-escape-sandbox">
      </iframe>
    </div>
  </div>
</div>

<style>
  /* Standalone view full screen settings: hide general navbar/footer to give a clean standalone portal feel */
  .navbar, .footer {
    display: none !important;
  }
  main {
    padding-top: 0 !important;
    margin-top: 0 !important;
  }
</style>

<script>
  // Robust vanilla JS fallback for direct loading scenarios
  (function() {
    var iframe = document.querySelector('.volunteer-page-view .volunteer-modal__iframe');
    var loader = document.querySelector('.volunteer-page-view .volunteer-modal__loader');
    if (iframe && loader) {
      iframe.addEventListener('load', function() {
        loader.style.display = 'none';
        iframe.style.opacity = '1';
      });
      // Handle cache/safari loading triggers
      if (iframe.complete) {
        loader.style.display = 'none';
        iframe.style.opacity = '1';
      }
    }
  })();
</script>
