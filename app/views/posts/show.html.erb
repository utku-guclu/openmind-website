<% content_for(:title) { "#{@post.title} — OpenmindProjects" } %>
<% content_for(:description) { @post.summary } %>

<section class="about" style="padding-top: 120px;">
  <div class="container">
    <div class="section-header">
      <span class="section-header__tag"><i class="ph ph-newspaper"></i> <%= @post.category&.titleize || "News" %></span>
      <h1 class="section-header__title"><%= @post.title %></h1>
      <p class="section-header__desc">
        <i class="ph ph-calendar-blank"></i> <%= @post.published_at&.strftime("%B %d, %Y") %>
        <% if @post.author %>
          · <i class="ph ph-user"></i> <%= @post.author.name %>
        <% end %>
      </p>
    </div>

    <div style="max-width: 800px; margin: 0 auto;">
      <div class="about__card" style="margin-bottom: var(--space-xl);">
        <div style="line-height: 1.8; color: var(--color-text-secondary);">
          <%= @post.body&.html_safe || @post.summary %>
        </div>
      </div>

      <div style="text-align: center; margin-top: var(--space-2xl);">
        <%= link_to news_index_path, class: "btn btn--glass btn--lg" do %>
          <i class="ph ph-arrow-left"></i> Back to News
        <% end %>
      </div>
    </div>

    <% if @related_posts.any? %>
      <div style="margin-top: var(--space-4xl);">
        <h2 style="text-align: center; margin-bottom: var(--space-xl);">Related Stories</h2>
        <div class="programs__grid">
          <% @related_posts.each do |post| %>
            <div class="program-card">
              <% if post.category.present? %>
                <div class="program-card__badge"><%= post.category.titleize %></div>
              <% end %>
              <h3 class="program-card__title"><%= post.title %></h3>
              <p class="program-card__desc"><%= post.summary %></p>
              <%= link_to "Read More", news_path(post.slug), class: "btn btn--primary btn--full" %>
            </div>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>
</section>
