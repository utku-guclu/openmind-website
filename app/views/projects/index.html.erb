<section class="programs" style="padding-top: 120px;">
  <div class="container">
    <div class="section-header">
      <span class="section-header__tag"><i class="ph ph-briefcase"></i> Our Projects</span>
      <h1 class="section-header__title">Volunteer <span class="text-primary">Projects</span></h1>
      <p class="section-header__desc">Explore our programs across Southeast Asia and find the perfect volunteer opportunity for you.</p>
    </div>

    <div class="programs__grid" style="grid-template-columns: repeat(auto-fill, minmax(400px, 1fr)); gap: 40px;">
      <% @projects.each do |project| %>
        <div class="program-card" id="project-<%= project.slug %>" style="padding: 0; overflow: hidden; display: flex; flex-direction: column;">
          <% if project.image.attached? %>
            <div style="height: 250px; width: 100%;">
              <%= image_tag project.image, style: "width: 100%; height: 100%; object-fit: cover;", alt: project.title %>
            </div>
          <% else %>
            <div style="height: 250px; width: 100%; background: var(--color-bg-tint); display: flex; align-items: center; justify-content: center;">
              <i class="ph ph-image" style="font-size: 3rem; color: var(--color-text-secondary);"></i>
            </div>
          <% end %>

          <div style="padding: 24px; display: flex; flex-direction: column; flex-grow: 1;">
            <h3 style="font-size: 1.25rem; font-weight: 700; color: var(--color-primary); margin-bottom: 12px; line-height: 1.4;">
              <%= link_to project.title, project_path(project.slug), style: "color: inherit; text-decoration: none;" %>
            </h3>

            <% if project.destination %>
              <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 16px; font-weight: 500; font-size: 0.9rem;">
                <span style="color: var(--color-text-secondary);">Project location:</span>
                <% if project.destination.country_code == 'TH' %>🇹🇭<% end %>
                <% if project.destination.country_code == 'NP' %>🇳🇵<% end %>
                <% if project.destination.country_code == 'LA' %>🇱🇦<% end %>
                <span style="color: var(--color-text);"><%= project.destination.name %></span>
              </div>
            <% end %>

            <div style="display: flex; gap: 12px; margin-bottom: 24px; color: var(--color-text-secondary); font-size: 0.95rem; line-height: 1.6; flex-grow: 1;">
              <i class="ph ph-check-circle" style="color: var(--color-accent); font-size: 1.2rem; margin-top: 3px; flex-shrink: 0;"></i>
              <p style="margin: 0;"><%= project.summary %></p>
            </div>

            <div style="display: flex; gap: 12px; margin-top: auto;">
              <%= link_to project_path(project.slug), class: "btn btn--ghost", style: "flex: 1; justify-content: center; font-size: 0.9rem; padding: 10px;" do %>
                <i class="ph ph-newspaper"></i> Learn more
              <% end %>
              
              <%= link_to new_application_path, class: "btn btn--primary", style: "flex: 1; justify-content: center; font-size: 0.9rem; padding: 10px;" do %>
                <i class="ph ph-check-circle"></i> Apply
              <% end %>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</section>
