<% content_for(:title) { "Volunteer Projects — OpenmindProjects" } %>

<section class="programs" style="padding-top: 120px; padding-bottom: var(--space-lg);">
  <div class="container">
    <div class="section-header">
      <span class="section-header__tag"><i class="ph ph-briefcase"></i> Our Projects</span>
      <h1 class="section-header__title">
        <% if @current_category && (meta = Project::CATEGORIES[@current_category]) %>
          <%= meta[:label] %> <span class="text-primary">Projects</span>
        <% else %>
          Volunteer <span class="text-primary">Projects</span>
        <% end %>
      </h1>
      <p class="section-header__desc">
        <% if @current_category %>
          Showing <%= pluralize(@projects.size, "project") %> in this category.
          <%= link_to "Clear filter", projects_path, style: "color: var(--color-primary); font-weight: 600;" %>
        <% else %>
          Explore our programs across Southeast Asia and find the perfect volunteer opportunity for you.
        <% end %>
      </p>
    </div>
  </div>
</section>

<%= render "organisms/category_filter",
      categories: @categories,
      current: @current_category,
      counts: @category_counts %>

<section class="programs" style="padding-top: var(--space-2xl);">
  <div class="container">
    <% if @projects.any? %>
      <div class="programs__grid" style="grid-template-columns: repeat(auto-fill, minmax(400px, 1fr)); gap: 40px;">
        <% @projects.each do |project| %>
          <div class="program-card" id="project-<%= project.slug %>" style="padding: 0; overflow: hidden; display: flex; flex-direction: column;">
            <% if project.image.attached? %>
              <div style="height: 250px; width: 100%;">
                <%= image_tag project.image, style: "width: 100%; height: 100%; object-fit: cover;", alt: project.title %>
              </div>
            <% else %>
              <div style="height: 250px; width: 100%; background: var(--color-bg-tint); display: flex; align-items: center; justify-content: center;">
                <i class="ph <%= project.category_icon %>" style="font-size: 3rem; color: var(--color-primary);"></i>
              </div>
            <% end %>

            <div style="padding: 24px; display: flex; flex-direction: column; flex-grow: 1;">
              <div style="margin-bottom: 12px;">
                <span class="category-badge category-badge--<%= project.category_color %>">
                  <i class="ph <%= project.category_icon %>"></i>
                  <%= project.category_label %>
                </span>
              </div>

              <h3 style="font-size: 1.25rem; font-weight: 700; color: var(--color-primary); margin-bottom: 12px; line-height: 1.4;">
                <%= link_to project.title, project_path(project.slug), style: "color: inherit; text-decoration: none;" %>
              </h3>

              <% if project.destination %>
                <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 16px; font-weight: 500; font-size: 0.9rem; flex-wrap: wrap;">
                  <span style="color: var(--color-text-secondary);">Location:</span>
                  <% if project.destination.country_code == 'TH' %>🇹🇭<% end %>
                  <% if project.destination.country_code == 'NP' %>🇳🇵<% end %>
                  <% if project.destination.country_code == 'LA' %>🇱🇦<% end %>
                  <span style="color: var(--color-text);"><%= project.destination.name %></span>
                  <% if project.location %>
                    <span style="color: var(--color-text-secondary);">·</span>
                    <span style="display: inline-flex; align-items: center; gap: 4px; color: var(--color-primary); font-weight: 600;">
                      <i class="ph ph-map-pin" style="font-size: .9rem;"></i><%= project.location.name %>
                    </span>
                  <% end %>
                </div>
              <% end %>

              <div style="display: flex; gap: 12px; margin-bottom: 24px; color: var(--color-text-secondary); font-size: 0.95rem; line-height: 1.6; flex-grow: 1;">
                <i class="ph ph-check-circle" style="color: var(--color-accent); font-size: 1.2rem; margin-top: 3px; flex-shrink: 0;"></i>
                <p style="margin: 0;"><%= project.summary %></p>
              </div>

              <div style="display: flex; gap: 12px; margin-top: auto;">
                <%= link_to project_path(project.slug), class: "btn btn--ghost", style: "flex: 1; justify-content: center; font-size: 0.9rem; padding: 10px;" do %>
                  <i class="ph ph-newspaper"></i> Learn more
                <% end %>

                <%= link_to new_application_path, class: "btn btn--primary", style: "flex: 1; justify-content: center; font-size: 0.9rem; padding: 10px;", data: { turbo_frame: "modal" } do %>
                  <i class="ph ph-check-circle"></i> Apply
                <% end %>
              </div>
            </div>
          </div>
        <% end %>
      </div>
    <% else %>
      <div style="text-align: center; padding: var(--space-3xl) 0; color: var(--color-text-secondary);">
        <i class="ph ph-funnel" style="font-size: 3rem; color: var(--color-primary-light); margin-bottom: var(--space-md);"></i>
        <h3 style="font-size: 1.25rem; margin-bottom: var(--space-sm);">No projects in this category yet</h3>
        <p style="margin-bottom: var(--space-lg);">Try another category — we're expanding new programs all the time.</p>
        <%= link_to "View all projects", projects_path, class: "btn btn--outline" %>
      </div>
    <% end %>
  </div>
</section>
