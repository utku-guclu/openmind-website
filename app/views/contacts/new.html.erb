<section class="about" style="padding-top: 120px;">
  <div class="container">
    <div class="section-header">
      <span class="section-header__tag"><i class="ph ph-envelope"></i> Contact</span>
      <h1 class="section-header__title">Get in <span class="text-primary">Touch</span></h1>
      <p class="section-header__desc">Have a question or want to learn more? Send us a message and we'll get back to you.</p>
    </div>

    <% if notice %>
      <div style="max-width: 600px; margin: 0 auto var(--space-xl); padding: var(--space-md); background: rgba(76,175,80,.1); border: 1px solid var(--color-green); border-radius: var(--radius-md); text-align: center; color: var(--color-green);">
        <%= notice %>
      </div>
    <% end %>

    <div style="max-width: 600px; margin: 0 auto;">
      <%= form_with model: @contact, url: contact_path, class: "form" do |f| %>
        <% if @contact.errors.any? %>
          <div style="padding: var(--space-md); background: rgba(231,76,60,.1); border: 1px solid #e74c3c; border-radius: var(--radius-md); margin-bottom: var(--space-lg); color: #e74c3c;">
            <% @contact.errors.full_messages.each do |msg| %>
              <p><%= msg %></p>
            <% end %>
          </div>
        <% end %>

        <div class="form__group">
          <%= f.label :name, class: "form__label" %>
          <%= f.text_field :name, class: "form__input", required: true, placeholder: "Your name" %>
        </div>

        <div class="form__group">
          <%= f.label :email, class: "form__label" %>
          <%= f.email_field :email, class: "form__input", required: true, placeholder: "your@email.com" %>
        </div>

        <div class="form__group">
          <%= f.label :subject, class: "form__label" %>
          <%= f.text_field :subject, class: "form__input", placeholder: "What's this about?" %>
        </div>

        <div class="form__group">
          <%= f.label :message, class: "form__label" %>
          <%= f.text_area :message, class: "form__input form__textarea", rows: 6, placeholder: "Your message..." %>
        </div>

        <%= f.submit "Send Message", class: "btn btn--accent btn--lg btn--full" %>
      <% end %>
    </div>
  </div>
</section>
