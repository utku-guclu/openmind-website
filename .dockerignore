# ═══════════════════════════════════════════════════════════════
# .dockerignore — Keep the Docker build context lean
# ═══════════════════════════════════════════════════════════════

# Git
.git
.gitignore
.gitattributes

# CI / IDE
.github
.vscode
.idea
.cursor
.gemini
devplan/

# Docker
.dockerignore
Dockerfile
docker-compose.yml
docker-compose*.yml

# Ruby / Bundler (gems are installed fresh in the image)
.bundle

# Node (if any JS tooling leaks in)
node_modules/

# Logs & temp
log/*
tmp/*
!log/.keep
!tmp/.keep

# Active Storage uploads (mounted as volume in production)
storage/*
!storage/.keep

# Database exports & seeds not needed in image
db/export/
db/*.sql
db/*.dump

# Test files
test/
spec/
coverage/

# Documentation
README.md
LICENSE
CHANGELOG.md
docs/
devplan/

# OS files
.DS_Store
Thumbs.db

# Credentials — passed via env vars, not baked in
config/master.key
.env
.env*

# Dev environment
Procfile.dev
.ruby-lsp/
.byebug_history
